# Local event configuration. Copy to an untracked .env and supply your own values.
NODE_ENV=development
APP_ENV=local
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
RESOURCE_PREFIX=realaddr-event
FIRESTORE_COLLECTION_PREFIX=realaddr_event_
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
GCP_PROJECT_ID=demo-realaddr-local
FIRESTORE_DATABASE_ID=realaddr
PAYMENT_NETWORK=eip155:84532
PRICE_PROFILE=testnet
# PAYMENT_ASSET=
# PAYMENT_PAY_TO=
# PAYMENT_DECIMALS=6
# PRICING_VERSION=
LEASE_PRICE_TESTNET_ATOMIC=550000
ENS_ADDON_STANDARD_PRICE_TESTNET_DEV_ATOMIC=100000
ENS_ADDON_CUSTOM_PRICE_TESTNET_DEV_ATOMIC=300000
LEASE_PERIOD_DAYS=30
TERMS_VERSION=event-demo-1
# Event API and Web builds require the approved TERMS_VERSION=realaddr-v1.
# RATE_LIMIT_HMAC_KEY=
# Cloud Tasks dispatch is opt-in and remains disabled for local use.
CLOUD_TASKS_DISPATCH_ENABLED=false
# Set true only for APP_ENV=event after dedicated resources and runtime identity are verified.
# CLOUD_TASKS_DISPATCH_ENABLED=true
# GCP_REGION=
# TASKS_QUEUE=realaddr-event-jobs
# WORKER_URL=
# TASK_INVOKER_SA=<dedicated-task-invoker>
# SCHEDULER_INVOKER_SA=
# AGENT_API_ORIGIN=http://localhost:8080
# AGENT_SIGNER_KEY_REF=
# AGENT_CREDENTIAL_FILE=
# Configure these from protected local settings before any live sponsor call.
# INTERCEPTA_API_KEY=
# Address screening uses the fixed provider endpoint; no payment or signing is enabled.
# MULTIBAAS_URL=
# MULTIBAAS_API_KEY=
# World uses the official event sandbox. Authentication alone never grants consent.
WORLD_ENABLED=false
# WORLD_CLIENT_ID=
# WORLD_CLIENT_SECRET=
# WORLD_REDIRECT_URI=https://address.chain.tokyo/auth/world/callback
# WORLD_SESSION_KEY=
# MAIL_ENCRYPTION_KEY=
# The two encryption keys must each be independent base64-encoded random 32-byte keys.
# MULTIBAAS_CHAIN_LABEL=
# LeaseRegistry reconciliation only; no transaction writer or signing key is configured.
REGISTRY_READBACK_ENABLED=false
# REGISTRY_CHAIN_ID=11155111
# REGISTRY_ADDRESS=
# REGISTRY_CONTRACT_LABEL=
# REGISTRY_CONTRACT_VERSION=
# REGISTRY_RUNTIME_CODE_HASH=
# MULTIBAAS_CHAIN_LABEL=ethereum
# REGISTRY_RPC_URL=
# REGISTRY_FINALITY_POLICY=finalized
