{
  "name": "@realaddr/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:google-auth-library --external:@google-cloud/firestore --outfile=dist/index.js",
    "typecheck": "tsc --project tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "viem": "2.40.0",
    "fastify": "5.12.5",
    "google-auth-library": "10.4.0",
    "@google-cloud/firestore": "7.11.6",
    "@realaddr/db": "workspace:*"
  }
}
