{
  "name": "@realaddr/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@google-cloud/firestore --external:viem --outfile=dist/index.js",
    "typecheck": "tsc --project tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@realaddr/db": "workspace:*",
    "@realaddr/domain": "workspace:*",
    "@google-cloud/firestore": "7.11.6",
    "fastify": "5.12.5",
    "viem": "2.40.0"
  }
}
